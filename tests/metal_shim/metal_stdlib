HA_TR(half2, half, 2) HA_TR(half3, half, 3) HA_TR(half4, half, 4)

template <class T, int N, class V> struct packed_vec {
    T v[N];
    packed_vec() = default;
    packed_vec(V x) { for (int i = 0; i < N; i++) v[i] = x[i]; }
    operator V() const { V r; for (int i = 0; i < N; i++) r[i] = v[i]; return r; }
    T &operator[](int i) { return v[i]; }
    const T &operator[](int i) const { return v[i]; }
};
typedef packed_vec<float, 2, float2> packed_float2;
typedef packed_vec<float, 3, float3> packed_float3;
typedef packed_vec<float, 4, float4> packed_float4;
typedef packed_vec<int, 2, int2> packed_int2;
typedef packed_vec<int, 3, int3> packed_int3;
typedef packed_vec<int, 4, int4> packed_int4;
typedef packed_vec<uint, 2, uint2> packed_uint2;
typedef packed_vec<uint, 3, uint3> packed_uint3;
typedef packed_vec<uint, 4, uint4> packed_uint4;
typedef packed_vec<half, 2, half2> packed_half2;
typedef packed_vec<half, 3, half3> packed_half3;
typedef packed_vec<half, 4, half4> packed_half4;

